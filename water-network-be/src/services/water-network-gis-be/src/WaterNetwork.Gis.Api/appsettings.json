{
  "ServiceName": "water-network-gis-be",
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=wn_gis;Username=postgres;Password=postgres",
    "Redis": ""
  },
  "EventBus": {
    "Producer": "water-network-gis-be",
    "Transport": "RabbitMq"
  },
  "MassTransit": {
    "RabbitMq": {
      "Host": "localhost",
      "Username": "guest",
      "Password": "guest"
    }
  },
  "MultiTenancy": {
    "AllowHeaderFallback": true,
    "AllowFlatTenantClaimCompatibility": true
  },
  "GisQuery": {
    "Bbox": {
      "MaxAreaSquareDegrees": 1.0,
      "DefaultLimit": 2000,
      "MaxLimit": 10000
    }
  },
  "Jwt": {
    "Mode": "Mock",
    "AllowedAuthorizedParties": ["water-network-gis-fe"]
  },
  "Outbox": {
    "BatchSize": 20,
    "MaxRetries": 5,
    "PollingIntervalSeconds": 5
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  }
}
