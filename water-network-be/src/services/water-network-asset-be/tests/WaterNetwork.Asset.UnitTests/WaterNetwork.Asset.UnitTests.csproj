<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707;CA1822;CA1852;CA2211</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/WaterNetwork.Asset.Domain/WaterNetwork.Asset.Domain.csproj" />
    <ProjectReference Include="../../src/WaterNetwork.Asset.Application/WaterNetwork.Asset.Application.csproj" />
    <ProjectReference Include="../../src/WaterNetwork.Asset.Infrastructure/WaterNetwork.Asset.Infrastructure.csproj" />
    <ProjectReference Include="../../src/WaterNetwork.Asset.Contracts/WaterNetwork.Asset.Contracts.csproj" />
  </ItemGroup>

</Project>
