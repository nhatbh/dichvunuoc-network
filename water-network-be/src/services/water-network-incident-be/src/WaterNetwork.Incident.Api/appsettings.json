{
  "ServiceName": "water-network-incident-be",
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=wn_incident;Username=postgres;Password=postgres",
    "Redis": ""
  },
  "EventBus": { "Producer": "water-network-incident-be", "Transport": "RabbitMq" },
  "MassTransit": { "RabbitMq": { "Host": "localhost", "Username": "guest", "Password": "guest" } },
  "MultiTenancy": {
    "AllowHeaderFallback": true,
    "AllowFlatTenantClaimCompatibility": true
  },
  "Jwt": { "Mode": "Mock" },
  "Outbox": { "BatchSize": 20, "MaxRetries": 5, "PollingIntervalSeconds": 5 },
  "GisLookup": {
    "Provider": "Stub",
    "BaseUrl": "http://water-network-gis-be:8080",
    "ExistingRefs": []
  },
  "Topology": {
    "Provider": "Grpc",
    "BaseUrl": "http://water-network-topology-rs:50051",
    "DeadlineSeconds": 5
  },
  "Database": { "ApplyMigrationsOnStartup": false },
  "Serilog": { "MinimumLevel": { "Default": "Information" } }
}
