{
  "ServiceName": "water-network-design-be",
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=wn_design;Username=postgres;Password=postgres",
    "Redis": ""
  },
  "EventBus": {
    "Producer": "water-network-design-be",
    "Transport": "RabbitMq"
  },
  "MassTransit": {
    "RabbitMq": { "Host": "localhost", "Username": "guest", "Password": "guest" }
  },
  "MultiTenancy": {
    "AllowHeaderFallback": true,
    "AllowFlatTenantClaimCompatibility": true
  },
  "Jwt": { "Mode": "Mock" },
  "Outbox": { "BatchSize": 20, "MaxRetries": 5, "PollingIntervalSeconds": 5 },
  "FileStorage": {
    "Provider": "LocalDisk",
    "LocalDisk": { "RootPath": "/tmp/wn-design-files" },
    "MaxSizeBytes": 52428800,
    "AllowedContentTypes": [
      "application/pdf",
      "image/vnd.dwg",
      "image/vnd.dxf",
      "application/dxf",
      "application/acad",
      "application/geo+json",
      "application/json",
      "application/octet-stream"
    ]
  },
  "GisLookup": {
    "Provider": "Stub",
    "BaseUrl": "http://water-network-gis-be:8080",
    "ExistingCodes": []
  },
  "Database": { "ApplyMigrationsOnStartup": false },
  "Serilog": { "MinimumLevel": { "Default": "Information" } }
}
