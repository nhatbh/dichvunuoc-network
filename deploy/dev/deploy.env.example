# deploy/dev/deploy.env — copy this file to deploy.env and fill it in. deploy.env is git-ignored:
# it holds the shared services' passwords. Run `deploy.ps1 -Discover` to list what the cluster has.
# Lines are KEY=VALUE; no quotes needed.

# --- cluster -------------------------------------------------------------------------------
# ssh alias of the k3s server (the tino32 dev access pack; VPN on)
SSH_HOST=tino32
NAMESPACE=platform-core
INGRESS_CLASS=nginx
TLS_SECRET=wildcard-dichvunuoc-tls
# images are pushed here (run `docker login registry-dev.dichvunuoc.vn` once)
REGISTRY=registry-dev.dichvunuoc.vn/water-platform

# --- where SYSTEM 3D is served (needs a DNS A record to the cluster ingress) ------------------
FRONTEND_HOST=gis3d-dev.dichvunuoc.vn
MAP_LON=105.4935
MAP_LAT=21.178
MAP_ZOOM=14

# --- Keycloak (existing) --------------------------------------------------------------------
KEYCLOAK_URL=https://auth-dev.dichvunuoc.vn
KEYCLOAK_REALM=water-platform
# the SPA client; its Valid Redirect URIs / Web Origins must include https://<FRONTEND_HOST>/*
KEYCLOAK_CLIENT_ID=water-network-gis-fe
JWT_AUDIENCE=water-platform
MENU_APP_URL=https://apps-dev.dichvunuoc.vn

# --- app catalog (tenant-to-app entitlement check in the BFF) --------------------------------
APP_CATALOG_URL=
APP_CODE=ml-0
# false = skip the app-catalog check in the BFF (dev only, decision 0031): use while the catalog has
# no record for the GIS app. Sign-in and permissions are still checked.
APP_ENTITLEMENT_ENABLED=true
# true = CAD import and the editor accept the flat tenant_id claim (dev, decision 0031): use while
# users are not members of a Keycloak Organization. The frontend and the import service both follow.
ALLOW_FLAT_TENANT=false

# --- shared PostgreSQL (PostGIS available). Databases wn_gis, wn_asset, wn_design are created
#     by the migrations if the user may create databases; otherwise create them first. --------
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
# extra Npgsql options, e.g. SSL Mode=Disable
POSTGRES_OPTIONS=

# --- shared Redis ---------------------------------------------------------------------------
REDIS_HOST=
REDIS_PORT=6379
# a Redis password must not contain commas
REDIS_PASSWORD=

# --- shared RabbitMQ ------------------------------------------------------------------------
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USER=
RABBITMQ_PASSWORD=
