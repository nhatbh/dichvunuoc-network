# `npm run dev:local-stack` — the app against the real backend services on this machine
# (water-network-be docker compose + docker-compose.local.yml). Sign in with the mock login;
# the dev server's /api/gis proxy swaps the mock session for a backend dev JWT (Jwt:Mode=Mock).
# /config.json is served from deploy/local-stack/config.json (canonical data source).
VITE_AUTH_MODE=mock
VITE_USE_MOCK_AUTH=true
VITE_USE_MOCK_DATA=false
VITE_USE_RUNTIME_CONFIG=true
VITE_API_URL=/api/gis
VITE_MOCK_PERMISSIONS=network-gis:read,network-design:read,network-design:write,network-design:approve
VITE_MOCK_TENANT=local-dev
