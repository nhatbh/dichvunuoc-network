# `npm run dev:mock` — everything runs in the browser, no backend / Docker / Keycloak.
# Sign in with demo@example.com / password123.
VITE_USE_MOCK_DATA=true
VITE_USE_MOCK_AUTH=true
VITE_AUTH_MODE=mock
# Ignore public/config.json (it points at the deployed dev API).
VITE_USE_RUNTIME_CONFIG=false
VITE_API_URL=http://localhost:4600/api/gis

# The demo user may edit and approve network designs (editor → revision workflow).
VITE_MOCK_PERMISSIONS=network-design:write,network-design:approve
