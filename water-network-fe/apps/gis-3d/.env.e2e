# `npm run build:e2e` — a minified production bundle of the app with mock auth and the e2e hooks
# switched on, so Playwright can run it without Keycloak or a backend (data is served by the
# tests themselves, see e2e/helpers/open-map.ts). Not for deployment.
VITE_AUTH_MODE=mock
VITE_USE_MOCK_AUTH=true
VITE_USE_MOCK_DATA=false
VITE_USE_RUNTIME_CONFIG=true
VITE_E2E_HOOKS=true
VITE_MOCK_PERMISSIONS=network-design:write,network-design:approve
