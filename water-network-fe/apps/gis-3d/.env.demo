# `pnpm run build:demo` — frontend-only DEMO bundle: mock login (demo@example.com / password123),
# mock Hanoi network served by MSW inside the browser, no backend / Keycloak. Not for production.
# Deployed by deploy/demo (see deploy/demo/README.md).
VITE_DEMO=true
VITE_AUTH_MODE=mock
VITE_USE_MOCK_AUTH=true
VITE_USE_MOCK_DATA=true
VITE_USE_RUNTIME_CONFIG=false
VITE_API_URL=/api/gis
VITE_MOCK_PERMISSIONS=network-design:write,network-design:approve
